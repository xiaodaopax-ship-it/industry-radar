{
  "_readme": "全局配置。SEC 要求请求头里带联系方式：优先读环境变量 SEC_USER_AGENT，这里的值只作为兜底。",
  "sec_user_agent": "industry-radar (you@example.com)",
  "current_quarter": "CY2026Q2",
  "revenue_tags": ["RevenueFromContractWithCustomerExcludingAssessedTax", "Revenues", "RevenueFromContractWithCustomerIncludingAssessedTax"],
  "financial_tags": {
    "_readme": "金融类评估口径（profile = financial）用的 XBRL 标签，按顺序取第一个有值的。券商和放贷公司常把手续费部分报成 RevenueFromContractWithCustomer...，总收入（含净利息）在 RevenuesNetOfInterestExpense 或 Revenues，所以金融类的营收标签顺序不同；只用于金融类环节，其他行业不受影响。拨备：ProvisionForLoanLossesExpensed（COF、SYF、SEZL 等）和 ASC 326 的 FinancingReceivableExcludingAccruedInterestCreditLossExpenseReversal（SOFI 等）；按公允价值计量贷款的公司（如 UPST）没有拨备科目。",
    "revenue": ["RevenuesNetOfInterestExpense", "Revenues", "RevenueFromContractWithCustomerExcludingAssessedTax", "RevenueFromContractWithCustomerIncludingAssessedTax"],
    "pretax": ["IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest", "IncomeLossFromContinuingOperationsBeforeIncomeTaxesMinorityInterestAndIncomeLossFromEquityMethodInvestments"],
    "equity": ["StockholdersEquity", "StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest"],
    "provision": ["ProvisionForLoanLossesExpensed", "FinancingReceivableExcludingAccruedInterestCreditLossExpenseReversal", "ProvisionForLoanLeaseAndOtherLosses", "ProvisionForLoanAndLeaseLosses"],
    "net_interest": ["InterestIncomeExpenseNet"]
  },
  "market_benchmark": {"symbol": "SPY", "name": "标普 500 ETF"},
  "deep_dives": {"INTC": "deep-dive/intel/index.html"},

  "screen": {
    "_readme": "新兴公司的默认门槛（美元），行业或环节可以在 sectors.json 里覆盖。",
    "ttm_revenue_min": 50000000,
    "ttm_revenue_max": 3000000000,
    "prior_quarter_revenue_min": 5000000,
    "yoy_growth_min": 20,
    "yoy_growth_max_sanity": 1000,
    "market_cap_max": 15000000000,
    "market_cap_min_intl": 200000000,
    "exchanges": ["Nasdaq", "NYSE", "NYSE American"]
  },

  "intl": {
    "_readme": "海外市场通过 Yahoo 筛选器取股票池、用 Yahoo 财务时间序列取季度数据。日本只有年度数据，按年度同比计算并标注。",
    "fx": {"TWD": "TWD=X", "JPY": "JPY=X", "KRW": "KRW=X", "HKD": "HKD=X", "EUR": "EURUSD=X"},
    "max_per_query": 250
  },

  "flags": {
    "few_analysts_max": 3, "many_analysts_min": 10, "dilution_warn_pct": 10, "gm_jump_warn_pp": 15,
    "runway_warn_quarters": 6, "low_gm_pct": 25, "high_gm_pct": 50, "rich_ps": 15, "eps_beat_pct": 10,
    "peg": {"_readme": "PEG = 市盈率（TTM）÷ 一致预期 EPS 增速（Yahoo earningsTrend，本财年 0y → 下一财年 +1y，只有一年）。FY1 预期分析师少于 min_analysts 家或任一预期 ≤ 0 时改用历史口径（只有年度数据的公司：最新财年净利润同比），都没有就不显示。增速 > growth_unreliable_pct 或基数 EPS / 股价 < min_eps_yield_pct 时照样显示但标为不可靠，不参与判断。标准口径的周期性环节不显示。",
            "good_max": 1.0, "rich_min": 2.0, "growth_unreliable_pct": 100, "min_eps_yield_pct": 0.5, "min_analysts": 3},
    "financial": {"_readme": "金融类口径（券商、交易所、放贷）的提示阈值", "roe_good_pct": 15, "roe_low_pct": 8, "rich_pb": 5,
                  "pretax_low_pct": 10, "pretax_high_pct": 30, "prov_up_warn_pp": 2, "prov_high_pct": 30, "nci_warn_pct": 30}
  },

  "pool": {
    "_readme": "研究优先池：先过门槛，再按各因子在本行业候选中的百分位排名取平均。权重相同，没有回测，只用来排研究顺序。",
    "size": 5,
    "gates": {"exclude_cyclical": true, "require_market_data": true, "max_dilution_pct": 50, "min_runway_quarters": 6, "max_yoy_pct": 300, "min_mcap": 200000000},
    "anomaly": {"opm_jump_pp": 40, "surprise_small_base_pct": 100},
    "factors": ["growth", "accel", "gm", "gm_trend", "op_margin", "value", "dilution", "insider", "coverage", "surprise"],
    "financial": {
      "_readme": "金融类环节（profile = financial）：周期性环节不剔除，只提示；用『TTM 净亏损』代替『亏损且现金不足』（现金大多是客户资金）；股东权益为负剔除。百分位只在同一口径的公司里计算。",
      "require_ttm_profit": true,
      "factors": ["growth", "accel", "pretax_m", "pretax_trend", "roe", "value_fin", "equity_g", "dilution", "insider", "coverage", "surprise"]
    }
  },

  "form4": {"lookback_days": 180, "max_filings_per_company": 8},
  "cache_days": {"submissions": 7, "yahoo": 1}
}
